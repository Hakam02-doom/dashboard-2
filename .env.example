# Public browser configuration; dedicated Dashboard 2 project only.
VITE_SUPABASE_URL=https://grpskfvjpnmgkdfuvcll.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix these with VITE_. Never commit credentials.
SUPABASE_SERVICE_ROLE_KEY=
SEARCHAPI_API_KEY=
OPENAI_API_KEY=
AI_CRON_SECRET=
# Lifetime authorization, including prior attempts. Server maximum is $15.
AI_ANALYSIS_BUDGET_USD=1

# Direct research collectors — disabled until explicitly configured.
# Never prefix these keys with VITE_. Supply a currently supported model ID.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
AI_DIRECT_COLLECTION_ENABLED=false
# Lifetime combined request allowance (including failed attempts), not a dollar budget.
AI_DIRECT_MAX_REQUESTS=0

# Optional, read-only Google traffic connector. JSON stays server-side.
# Grant the service account Viewer access to the matching GA4 and Search Console properties.
GOOGLE_SERVICE_ACCOUNT_JSON=
